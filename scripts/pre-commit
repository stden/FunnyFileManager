#!/usr/bin/env bash
# Purpose: Runs local checks before a commit is accepted.
#
# Simple pre-commit hook for FunnyFileManager (no pre-commit framework required).
# Formats Rust code, then runs the same clippy matrix CI enforces.
#
# Usage (no extra tools required):
#   chmod +x scripts/pre-commit
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
#
# This will run on every `git commit`.
# Formatting changes are applied to the working tree — stage them if fmt rewrote
# files (`git add -u`) and commit again.
#
# To bypass (not recommended for normal work):
#   git commit --no-verify
#
# Faster alternative when iterating:
#   SKIP_CLIPPY=1 git commit ...
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo "→ Running cargo fmt (auto-format)..."
cargo fmt --all
if [[ -f mcp/Cargo.toml ]]; then
    echo "→ Formatting mcp/ crate..."
    (cd mcp && cargo fmt --all)
fi

if [[ "${SKIP_CLIPPY:-}" == "1" ]]; then
    echo "→ Skipping clippy (SKIP_CLIPPY=1)."
    exit 0
fi

echo "→ Running Rust linter gate (clippy)..."
bash "$ROOT/scripts/lint.sh" clippy

echo "→ Pre-commit checks passed."
echo "   If fmt rewrote files, stage them (git add -u) before committing again."
