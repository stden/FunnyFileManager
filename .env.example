# Purpose: Documents environment variables that can be copied into a local .env file.
# FunnyFileManager local environment
APP_ENV=development
LOG_LEVEL=info

# Optional AWS S3 integration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL=
S3_BUCKET=

# Optional MCP server security controls (ffm-mcp)
FFM_MCP_ROOT=
FFM_MCP_READONLY=0
FFM_MCP_ALLOW_KDBX=0

# Optional site-specific private word patterns for private_data_lint_test
FFM_PRIVATE_WORDS_FILE=
