# Purpose: Keeps secrets, generated output and bulky artifacts out of AI assistants' context.
# Gitignore syntax (JetBrains AI Assistant and Junie read this file).

# Secrets and credentials
.env
.env.local
.env.*.local
!.env.example
*.kdbx
*.kbdx
*.kdbx.bak
*.kbdx.bak
*.pem
*.key
*.p12
*.pfx

# Machine-specific MCP configs (may hold tokens) — generated by install_mcp.py
.claude/settings.local.json
.junie/mcp.json
.kiro/settings/mcp.json
.gemini/settings.json
.cursor/mcp.json

# Build output
/target/
/target-*/
/mcp/target/
/colorer-sys/target/
**/*.rs.bk
*.pdb
__pycache__/
Cargo.lock
!/mcp/Cargo.lock

# Coverage, mutation and profiling artifacts
*.profraw
*.profdata
coverage/
coverage.txt
tarpaulin-report.html
tarpaulin-report.json
mutants.out/
mutants.out.old/
mutants_utils.log
__cov_smoke*
*.lcov
htmlcov/

# Runtime logs
ffm_actions.log
ffm_errors.log
cron.log
*.log

# Data files and recordings
*.sqlite
*.db
*.jsonl

# Downloaded upstream reference docs and generated documents
/docs/upstream/
ffm.pdf

# Linked checkouts and tool state
/wt-*/
.claude/worktrees/
.superpowers/
.rustup/
.cargo-*/
node_modules/
